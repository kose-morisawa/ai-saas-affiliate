---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ねこみみ先生のAIツール大学 | AI/SaaSツール比較・使い方</title>
    <meta name="description" content="AI・SaaSツールの比較・使い方・料金を実際に使って解説。エンジニア・会社員向けのAIツール情報メディア。" />
    <style>
      body { font-family: "Hiragino Sans", "Noto Sans JP", sans-serif; max-width: 900px; margin: 0 auto; padding: 1rem 1.5rem; color: #1a1a1a; }
      h1 { font-size: 1.6rem; }
      .post-list { list-style: none; padding: 0; }
      .post-item { border-bottom: 1px solid #e5e7eb; padding: 1rem 0; }
      .post-item a { text-decoration: none; color: #1a1a1a; font-weight: 600; font-size: 1.1rem; }
      .post-item a:hover { color: #5b21b6; }
      .post-meta { font-size: .85em; color: #6b7280; margin-top: .25rem; }
      .post-desc { margin-top: .4rem; font-size: .95em; color: #374151; }
    </style>
  </head>
  <body>
    <header>
      <h1>🐱 ねこみみ先生のAIツール大学</h1>
      <p>AI・SaaSツールを実際に使って比較・解説するメディア</p>
    </header>
    <main>
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            <div class="post-meta">
              {post.data.pubDate.toLocaleDateString("ja-JP")}
              {post.data.tags.map((t) => ` · ${t}`)}
            </div>
            <div class="post-desc">{post.data.description}</div>
          </li>
        ))}
      </ul>
      {posts.length === 0 && <p>記事を準備中です。</p>}
    </main>
  </body>
</html>
