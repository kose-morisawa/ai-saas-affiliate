---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const formattedPub = pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
const formattedUpd = updatedDate?.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ねこみみ先生のAIツール大学</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <style>
      body { font-family: "Hiragino Sans", "Noto Sans JP", sans-serif; max-width: 800px; margin: 0 auto; padding: 1rem 1.5rem; line-height: 1.8; color: #1a1a1a; }
      h1 { font-size: 1.8rem; margin-top: 1.5rem; }
      h2 { font-size: 1.4rem; border-left: 4px solid #5b21b6; padding-left: .75rem; margin-top: 2.5rem; }
      h3 { font-size: 1.15rem; margin-top: 1.8rem; }
      table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
      th, td { border: 1px solid #e5e7eb; padding: .5rem .75rem; text-align: left; }
      th { background: #f3f4f6; }
      code { background: #f3f4f6; padding: .1rem .3rem; border-radius: 3px; font-size: .9em; }
      pre { background: #1e1e2e; color: #cdd6f4; padding: 1rem; border-radius: 8px; overflow-x: auto; }
      blockquote { border-left: 4px solid #d1d5db; padding-left: 1rem; color: #6b7280; margin: 1rem 0; }
      .pr-notice { background: #fef9c3; border: 1px solid #fde047; padding: .5rem 1rem; border-radius: 6px; font-size: .9em; margin: 1rem 0; }
      .tags { display: flex; gap: .5rem; flex-wrap: wrap; margin: .5rem 0 1.5rem; }
      .tag { background: #ede9fe; color: #5b21b6; padding: .2rem .6rem; border-radius: 999px; font-size: .8em; }
      cite { font-size: .85em; color: #6b7280; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">← ねこみみ先生のAIツール大学</a>
    </header>
    <main>
      <article>
        <h1>{title}</h1>
        <div class="tags">
          {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <p style="font-size:.85em;color:#6b7280;">
          公開: {formattedPub}
          {formattedUpd && ` | 更新: ${formattedUpd}`}
        </p>
        <slot />
      </article>
    </main>
    <footer style="margin-top:3rem;padding-top:1rem;border-top:1px solid #e5e7eb;font-size:.85em;color:#6b7280;">
      <p>© {new Date().getFullYear()} ねこみみ先生のAIツール大学</p>
    </footer>
  </body>
</html>
