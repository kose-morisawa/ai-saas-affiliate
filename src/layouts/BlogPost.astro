---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const formattedPub = pubDate.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
const formattedUpd = updatedDate?.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | ねこみみ先生のAIツール大学</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --purple: #7c3aed;
        --purple-light: #ede9fe;
        --cyan: #0ea5e9;
        --cyan-light: #e0f2fe;
        --orange: #f97316;
        --orange-light: #fff7ed;
        --green: #10b981;
        --green-light: #d1fae5;
        --pink: #ec4899;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-700: #334155;
        --gray-900: #0f172a;
      }

      body {
        font-family: "Noto Sans JP", "Hiragino Sans", sans-serif;
        background: #f0f4ff;
        color: var(--gray-900);
        line-height: 1.9;
      }

      /* NAV */
      .site-nav {
        background: white;
        border-bottom: 3px solid var(--purple);
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: 3.5rem;
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 2px 12px rgba(124,58,237,0.1);
      }
      .site-nav .brand {
        font-weight: 700;
        font-size: 1rem;
        color: var(--gray-900);
        text-decoration: none;
      }
      .site-nav .brand em { color: var(--purple); font-style: normal; }
      .site-nav .spacer { flex: 1; }
      .site-nav .back {
        font-size: 0.85rem;
        color: var(--gray-500);
        text-decoration: none;
        background: var(--gray-100);
        padding: 0.3rem 0.8rem;
        border-radius: 999px;
        transition: background 0.2s;
      }
      .site-nav .back:hover { background: var(--purple-light); color: var(--purple); }

      /* LAYOUT */
      .page-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 2rem 1.5rem 5rem;
        display: grid;
        grid-template-columns: 1fr 260px;
        gap: 2rem;
        align-items: start;
      }
      @media (max-width: 860px) {
        .page-wrapper { grid-template-columns: 1fr; }
        .toc-sidebar { display: none; }
      }

      /* ARTICLE CARD */
      article {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        padding: 2.5rem 3rem;
        min-width: 0;
      }
      @media (max-width: 600px) { article { padding: 1.5rem 1.25rem; } }

      /* TAGS */
      .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
      .tag {
        padding: 0.2rem 0.7rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .tag:nth-child(3n+1) { background: var(--purple-light); color: var(--purple); }
      .tag:nth-child(3n+2) { background: var(--cyan-light); color: var(--cyan); }
      .tag:nth-child(3n)   { background: var(--orange-light); color: var(--orange); }

      article h1 {
        font-size: clamp(1.4rem, 3vw, 1.85rem);
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: -0.02em;
        margin-bottom: 0.6rem;
      }

      .article-meta {
        font-size: 0.82rem;
        color: var(--gray-400);
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
      }

      /* PR NOTICE — subtle */
      .pr-notice {
        font-size: 0.75rem;
        color: var(--gray-400);
        margin-bottom: 1rem;
      }

      .divider {
        height: 2px;
        background: linear-gradient(90deg, var(--purple), var(--cyan), var(--orange));
        border-radius: 999px;
        margin: 1.5rem 0 2rem;
        opacity: 0.4;
      }

      /* PROSE */
      .prose h2 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 2.8rem 0 1rem;
        padding: 0.6rem 1rem;
        background: linear-gradient(135deg, var(--purple-light), var(--cyan-light));
        border-left: 5px solid var(--purple);
        border-radius: 0 10px 10px 0;
        line-height: 1.4;
      }
      .prose h3 {
        font-size: 1.08rem;
        font-weight: 700;
        margin: 2rem 0 0.6rem;
        color: var(--purple);
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }
      .prose h3::before {
        content: "▍";
        color: var(--cyan);
        font-size: 0.9em;
      }
      .prose h4 {
        font-size: 1rem;
        font-weight: 700;
        margin: 1.5rem 0 0.4rem;
        color: var(--gray-700);
      }
      .prose p { margin-bottom: 1.2rem; }
      .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 1.2rem; }
      .prose li { margin-bottom: 0.45rem; }
      .prose strong { font-weight: 700; color: var(--gray-900); }

      /* BLOCKQUOTE — PR表記をここで上書き */
      .prose blockquote {
        display: none; /* MDX内の > **PR** ブロックはlayoutのpr-noticeで代替済み */
      }

      /* TABLE */
      .prose table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 1.75rem 0;
        font-size: 0.88rem;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        display: block;
        overflow-x: auto;
      }
      .prose th {
        background: linear-gradient(135deg, #4c1d95, #0369a1);
        color: white;
        padding: 0.7rem 1rem;
        text-align: left;
        font-weight: 700;
        font-size: 0.85rem;
        white-space: nowrap;
        border-right: 1px solid rgba(255,255,255,0.15);
      }
      .prose th:last-child { border-right: none; }
      .prose td {
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--gray-200);
        border-right: 1px solid var(--gray-100);
        vertical-align: top;
      }
      .prose td:last-child { border-right: none; }
      .prose tr:nth-child(even) td { background: #f8f4ff; }
      .prose tr:last-child td { border-bottom: none; }
      .prose tr:hover td { background: var(--cyan-light); transition: background 0.15s; }

      /* CODE */
      .prose code {
        background: #fdf4ff;
        border: 1px solid #e9d5ff;
        padding: 0.15rem 0.45rem;
        border-radius: 5px;
        font-size: 0.85em;
        font-family: "Consolas", "Monaco", monospace;
        color: #7e22ce;
      }
      .prose pre {
        background: #1a1625;
        color: #e2e8f0;
        padding: 1.25rem 1.5rem;
        border-radius: 12px;
        overflow-x: auto;
        margin: 1.5rem 0;
        font-size: 0.875rem;
        line-height: 1.7;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.3);
      }
      .prose pre code { background: none; border: none; color: inherit; padding: 0; }

      /* CITE */
      .prose cite { font-size: 0.8rem; color: var(--gray-400); font-style: normal; }
      .prose cite a { color: var(--cyan); }

      /* CALLOUT-STYLE STRONG PARAGRAPH */
      .prose p:has(strong:first-child:last-child) {
        background: var(--orange-light);
        border-left: 4px solid var(--orange);
        padding: 0.75rem 1rem;
        border-radius: 0 8px 8px 0;
        margin: 1.5rem 0;
      }

      /* TOC SIDEBAR */
      .toc-sidebar {
        position: sticky;
        top: 4.5rem;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        padding: 1.25rem 1rem;
        border-top: 4px solid var(--cyan);
      }
      .toc-sidebar h2 {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--cyan);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid var(--gray-100);
      }
      .toc-sidebar ul { list-style: none; padding: 0; }
      .toc-sidebar li {
        margin-bottom: 1rem;
      }
      .toc-sidebar a {
        color: var(--gray-700);
        text-decoration: none;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.5rem 0.6rem;
        font-size: 0.8rem;
        line-height: 1.5;
        border-radius: 6px;
        transition: all 0.15s;
        border: 1px solid transparent;
      }
      .toc-sidebar a::before {
        content: "・";
        color: var(--cyan);
        font-size: 1rem;
        flex-shrink: 0;
        line-height: 1.3;
      }
      .toc-sidebar a:hover {
        background: var(--purple-light);
        color: var(--purple);
        border-color: var(--purple-light);
        padding-left: 0.9rem;
      }
      .toc-sidebar a:hover::before {
        color: var(--purple);
      }

      /* FOOTER */
      footer {
        background: var(--gray-900);
        color: var(--gray-500);
        text-align: center;
        padding: 2.5rem 1rem;
        font-size: 0.85rem;
      }
      footer a { color: var(--gray-400); text-decoration: none; }
    </style>
  </head>
  <body>
    <nav class="site-nav">
      <a class="brand" href="/ai-saas-affiliate/">🐱 ねこみみ先生の<em>AIツール大学</em></a>
      <div class="spacer"></div>
      <a class="back" href="/ai-saas-affiliate/">← 記事一覧</a>
    </nav>

    <div class="page-wrapper">
      <article>
        <div class="tags">
          {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <h1>{title}</h1>
        <div class="article-meta">
          <span>📅 {formattedPub}</span>
          {formattedUpd && <span>🔄 更新: {formattedUpd}</span>}
        </div>
        <p class="pr-notice">※本記事にはアフィリエイト広告が含まれます</p>
        <div class="divider"></div>
        <div class="prose">
          <slot />
        </div>
      </article>

      <aside class="toc-sidebar">
        <h2>目次</h2>
        <ul id="toc-list">
          <li><a href="#">読み込み中...</a></li>
        </ul>
      </aside>
    </div>

    <footer>
      <p>© {new Date().getFullYear()} ねこみみ先生のAIツール大学 &nbsp;|&nbsp; <a href="#">プライバシーポリシー</a></p>
    </footer>

    <script>
      const headings = document.querySelectorAll("article h2");
      const toc = document.getElementById("toc-list");
      if (toc && headings.length > 0) {
        toc.innerHTML = "";
        headings.forEach((h, i) => {
          if (!h.id) h.id = `section-${i}`;
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = `#${h.id}`;
          a.textContent = h.textContent ?? "";
          li.appendChild(a);
          toc.appendChild(li);
        });
      } else if (toc) {
        toc.innerHTML = "<li style='color:#94a3b8;padding:0.5rem'>見出しなし</li>";
      }
    </script>
  </body>
</html>
