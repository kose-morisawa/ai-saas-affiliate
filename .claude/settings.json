{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_TOOL_INPUT_FILE_PATHS||''; if(p.endsWith('.mdx')||p.endsWith('.ts')||p.endsWith('.astro')) { require('child_process').execSync('npx prettier --write \"'+p+'\" 2>/dev/null || true'); }\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(npx tsx:*)",
      "Bash(npm run:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  }
}
